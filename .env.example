# Copy this file to .env and fill in keys. Never commit the filled .env.

# Required for literature search
SERPAPI_API_KEY=

# Optional: grounded language-model analysis of retrieved evidence
ANTHROPIC_API_KEY=

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
MAX_SEARCHES_PER_RUN=20
CACHE_PATH=data/cache.sqlite
SERPAPI_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
